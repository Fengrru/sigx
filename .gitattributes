# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text eol=lf
*.pyi text eol=lf

# Documentation
*.md text eol=lf
*.rst text eol=lf

# Config files
*.toml text eol=lf
*.txt text eol=lf
*.cfg text eol=lf

# Shell scripts
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.ico binary
